<?xml version="1.0" encoding="UTF-8"?>
<!--
  ExportOptions for Development distribution (local install / registered devices).
  signingStyle automatic uses profiles from .xcodeproj; switch to manual for CI.
  Replace TEAMID and bundle-id → profile-name mapping when using manual signing.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>development</string>
    <key>destination</key>
    <string>export</string>
    <key>teamID</key>
    <string>TEAMID</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>com.example.myapp</key>
        <string>MyApp Development</string>
    </dict>
    <key>compileBitcode</key>
    <false/>
    <key>stripSwiftSymbols</key>
    <true/>
    <key>thinning</key>
    <string>&lt;none&gt;</string>
</dict>
</plist>
