<?xml version="1.0" encoding="UTF-8"?>
<!--
  ExportOptions for Developer ID distribution (macOS outside Mac App Store).
  Produces a .pkg for notarization and distribution. Replace TEAMID and bundle id mapping.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>developer-id</string>
    <key>destination</key>
    <string>export</string>
    <key>teamID</key>
    <string>TEAMID</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>signingCertificate</key>
    <string>Developer ID Application</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>com.example.mymacapp</key>
        <string>MyMacApp Developer ID</string>
    </dict>
    <key>installerSigningCertificate</key>
    <string>Developer ID Installer</string>
</dict>
</plist>
