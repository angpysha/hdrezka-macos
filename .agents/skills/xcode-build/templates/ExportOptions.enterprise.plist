<?xml version="1.0" encoding="UTF-8"?>
<!--
  ExportOptions for Enterprise (in-house) distribution — requires an Apple Developer
  Enterprise Program account and in-house provisioning profile. Manual signing.
  Misuse of enterprise certificates can revoke an entire catalog — isolate strictly.
  Replace TEAMID, bundle id, and profile name.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>enterprise</string>
    <key>destination</key>
    <string>export</string>
    <key>teamID</key>
    <string>TEAMID</string>
    <key>signingStyle</key>
    <string>manual</string>
    <key>signingCertificate</key>
    <string>Apple Distribution</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>com.example.myapp</key>
        <string>MyApp InHouse</string>
    </dict>
    <key>compileBitcode</key>
    <false/>
    <key>stripSwiftSymbols</key>
    <true/>
</dict>
</plist>
